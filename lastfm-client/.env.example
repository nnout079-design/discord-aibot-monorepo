MIDI_BRIDGE_URL=
DISCORD_TOKEN=your-token
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret
NODE_ENV=development
MENTAL_HEALTH_URL=http://localhost:8000

HUMANIZE_SEED=
MIDI_BRIDGE_BATCH=
COMPANION_TOKEN=
SYNC_TARGETS=
GETSONGBPM_API_KEY=

# Optional: Tuya / Smart Life galaxy projectors (cloud project at iot.tuya.com, linked to your Smart Life app)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# eu, eu-west, us, us-east, cn or in (the data center of your cloud project)
TUYA_REGION=eu
# Comma-separated device IDs: first = galaxy rig A, second = rig B
TUYA_DEVICE_IDS=
# Send each cue this many ms early to cover the cloud round trip
TUYA_LEAD_MS=300

# Optional: /studio diagnose (Gemini). Without a key a tag/BPM heuristic diagnoses instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per-user diagnoses per rolling window (default 5 per 24 h); comma-separated user IDs skip the quota
STUDIO_USER_QUOTA_LIMIT=5
STUDIO_USER_QUOTA_WINDOW_MS=86400000
STUDIO_QUOTA_ADMINS=
