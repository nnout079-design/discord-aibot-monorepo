# Mental Health Inference Service
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Model settings
DEVICE=cpu
USE_ONNX=false
CACHE_DIR=/app/.cache/huggingface

# Thresholds
CRISIS_THRESHOLD=0.5
EMOTION_THRESHOLD=0.5

# Safety / privacy
ANONYMIZE_USER_IDS=true
MAX_INPUT_LENGTH=4000

# Optional: override paths
# MODEL_CATALOG_PATH=/app/config/models.yaml
# RESOURCES_PATH=/app/config/resources.json
