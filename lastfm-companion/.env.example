# Get these from /companion in Discord (admin only, private reply)
BOT_URL=https://lastfm-client-bot.fly.dev
COMPANION_TOKEN=
# Part of the MIDI output name (see `npm run outputs`), or "none" to only log
MIDI_OUTPUT=loopMIDI
# Send MIDI clock + Start/Stop so a DAW follows the song entry (1/0)
MIDI_CLOCK=1
# Optional: local URL of your Electron app; it gets each event POSTed with local times
ELECTRON_URL=

# --- Full rig (optional) ---
# Rig map: `npm run rig -- --write` creates rig.json with all sections, ports and channels
RIG_FILE=rig.json
# 0 = old single-output mode (drums only)
RIG=1
# Your MIDI files (Artist - Title.mid or Artist/Title.mid); `npm run lakh` adds the Lakh set under songs/lakh
SONGS_DIR=songs
# 1 = generate an arrangement when no MIDI file matches
GENERATE=1
# all = bring in every world/epic section, not only the ones matching the song's tags
RIG_STYLE=

# --- Studios (npm run studio) ---
STUDIO_DIR=studio
# Leave empty after `npm run studio setup`; set only to use your own installs
SOUNDFONT=
FLUIDSYNTH=
FFMPEG=
# Optional: AI video backdrop (OpenAI images); without it the album cover is used
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
