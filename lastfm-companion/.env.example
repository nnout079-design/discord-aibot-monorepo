# Get these from /companion in Discord (admin only, private reply)
BOT_URL=https://lastfm-client-bot.fly.dev
COMPANION_TOKEN=
# Part of the MIDI output name (see `npm run outputs`), or "none" to only log
MIDI_OUTPUT=loopMIDI
# Send MIDI clock + Start/Stop so a DAW follows the song entry (1/0)
MIDI_CLOCK=1
# Optional: local URL of your Electron app; it gets each event POSTed with local times
ELECTRON_URL=
